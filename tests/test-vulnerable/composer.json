{
    "name": "test/vulnerable-php-project",
    "description": "Test project with known vulnerable PHP packages for end-to-end testing",
    "type": "application",
    "license": "MIT",
    "require": {
        "php": ">=7.4",
        "ext-json": "*",
        "ext-openssl": "*",
        "ext-curl": "*",
        "ext-mbstring": "*",
        "ext-xml": "*",
        "ext-gd": "*",
        "ext-zip": "*",
        "ext-pdo": "*",
        "symfony/http-foundation": "4.0.0",
        "twig/twig": "1.35.0",
        "doctrine/dbal": "2.5.0",
        "monolog/monolog": "1.17.0",
        "guzzlehttp/guzzle": "6.0.0",
        "phpmailer/phpmailer": "5.2.14",
        "firebase/php-jwt": "3.0.0",
        "league/flysystem": "1.0.0"
    },
    "require-dev": {
        "phpunit/phpunit": "6.0.0",
        "psy/psysh": "0.8.0"
    },
    "autoload": {
        "psr-4": {
            "Test\\Vulnerable\\": "src/"
        }
    }
}